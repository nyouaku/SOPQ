# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=stockopname
DB_PASSWORD=changeme
DB_NAME=stockopname_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_ACCESS_SECRET=change-this-to-a-random-secret-key-in-production
JWT_REFRESH_SECRET=change-this-to-another-random-secret-key-in-production
JWT_ACCESS_EXPIRY=15
JWT_REFRESH_EXPIRY=10080

# Server Configuration
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# Port nginx di host. Default 0.0.0.0:80 (akses LAN).
# Di VPS yang port 80-nya sudah dipakai app lain, ikat ke localhost:
#   NGINX_BIND=127.0.0.1
#   NGINX_PORT=8088
NGINX_BIND=0.0.0.0
NGINX_PORT=80

# Environment
ENV=production
